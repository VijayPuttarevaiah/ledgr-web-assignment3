# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache
supabase/.temp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.local IS committed for this project on purpose: it only
# contains the fixed, well-known local Supabase demo credentials (see
# README.md/DECISIONS.md), which have zero value outside your own machine's
# Docker containers. Any *real* secret must never be added to this file
# without renaming it to something still covered by the .env* pattern below.
.env*
!.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Assignment 3 ---
# A captured Supabase session (expires in an hour). Regenerate with
# `npm run capture:session` rather than committing one.
assignment3/jmeter/session.properties

# JMeter's generated HTML dashboards bundle ~500 files of vendored Bootstrap
# and jQuery each. The numbers they display are kept — statistics.json and
# the per-scenario CSVs are committed — and the dashboards themselves are
# regenerated by `./assignment3/scripts/run-jmeter.sh`.
assignment3/jmeter/results/*/light-report/
assignment3/jmeter/results/*/moderate-report/
assignment3/jmeter/results/*/*.log

# Assignment 3 report build artefact (regenerate with pandoc)
assignment3/report/report-print.html
