{
  "uid": "ledgr-overview",
  "title": "Ledgr — Application Health (Assignment 3)",
  "description": "Latency, error rate and resource utilisation for the Ledgr Next.js server. Application metrics come from prom-client via /api/metrics; host metrics come from node-exporter.",
  "tags": ["ledgr", "assignment3"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
        "query": "label_values(http_requests_total{job=\"ledgr-app\"}, route)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Service level indicators",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Throughput",
      "description": "Requests per second served by the Next.js process, all routes.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"ledgr-app\"}[1m]))",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate",
      "description": "Share of responses with a 4xx or 5xx status code. Green under 1%, amber to 5%, red above.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_errors_total{job=\"ledgr-app\"}[1m])) / clamp_min(sum(rate(http_requests_total{job=\"ledgr-app\"}[1m])), 0.001)",
          "legendFormat": "error ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latency p95",
      "description": "95th-percentile end-to-end server latency across all routes.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"ledgr-app\"}[1m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "App CPU",
      "description": "CPU consumed by the Node process serving Ledgr, as a percentage of one core. Values above 100% mean more than one core's worth of work (libuv threads, GC).",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 15, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"ledgr-app\"}[1m]) * 100",
          "legendFormat": "cpu %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "App memory (RSS)",
      "description": "Resident set size of the Ledgr Node process.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"ledgr-app\"}",
          "legendFormat": "rss"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "purple" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "row",
      "title": "Request latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Request latency percentiles (all routes)",
      "description": "Computed from the http_request_duration_seconds histogram. The gap between p50 and p95 is where queueing under load shows up.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"ledgr-app\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"ledgr-app\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"ledgr-app\"}[1m])))",
          "legendFormat": "p99"
        },
        {
          "refId": "D",
          "expr": "sum(rate(http_request_duration_seconds_sum{job=\"ledgr-app\"}[1m])) / clamp_min(sum(rate(http_request_duration_seconds_count{job=\"ledgr-app\"}[1m])), 0.001)",
          "legendFormat": "mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "p95 latency by route",
      "description": "Which endpoint is actually slow. Route labels are templates, not raw paths, so IDs do not explode the series count.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"ledgr-app\", route=~\"$route\"}[1m]))))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Throughput and errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "Traffic mix. During a JMeter run the static-bundle route dominates by count, which is why the latency panels are read per route rather than in aggregate.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{job=\"ledgr-app\", route=~\"$route\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Error rate and responses by status class",
      "description": "Left axis: 4xx/5xx responses per second. The overlaid 'error ratio' series is the same signal normalised by total traffic, which is what the alert rule fires on.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (rate(http_request_errors_total{job=\"ledgr-app\"}[1m]))",
          "legendFormat": "{{class}} responses"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_request_errors_total{job=\"ledgr-app\"}[1m])) / clamp_min(sum(rate(http_requests_total{job=\"ledgr-app\"}[1m])), 0.001)",
          "legendFormat": "error ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error ratio" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "5xx responses" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "4xx responses" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Resource utilisation",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "CPU utilisation — Ledgr process vs host",
      "description": "Process CPU is derived from process_cpu_seconds_total (user + system) and expressed as a percentage of a single core; host CPU is the inverse of node-exporter's idle time across all cores.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"ledgr-app\"}[1m]) * 100",
          "legendFormat": "ledgr process (% of one core)"
        },
        {
          "refId": "B",
          "expr": "rate(process_cpu_user_seconds_total{job=\"ledgr-app\"}[1m]) * 100",
          "legendFormat": "  user"
        },
        {
          "refId": "C",
          "expr": "rate(process_cpu_system_seconds_total{job=\"ledgr-app\"}[1m]) * 100",
          "legendFormat": "  system"
        },
        {
          "refId": "D",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{job=\"node-exporter\", mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "host (all cores)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "host (all cores)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Memory usage — Ledgr process",
      "description": "Resident set size against the V8 heap. RSS growing while heap-used stays flat points at native/buffer allocation rather than a JavaScript leak.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"ledgr-app\"}",
          "legendFormat": "resident set size"
        },
        {
          "refId": "B",
          "expr": "nodejs_heap_size_total_bytes{job=\"ledgr-app\"}",
          "legendFormat": "V8 heap total"
        },
        {
          "refId": "C",
          "expr": "nodejs_heap_size_used_bytes{job=\"ledgr-app\"}",
          "legendFormat": "V8 heap used"
        },
        {
          "refId": "D",
          "expr": "nodejs_external_memory_bytes{job=\"ledgr-app\"}",
          "legendFormat": "external"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Concurrency — requests in flight",
      "description": "Requests accepted but not yet answered. A rising line while throughput stays flat is the signature of saturation rather than of extra traffic.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 36 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_requests_in_flight{job=\"ledgr-app\"})",
          "legendFormat": "in flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Event-loop lag (p99)",
      "description": "How long a callback waits for the Node event loop. This is the metric that explains latency the database cannot account for.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 36 },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"ledgr-app\"}",
          "legendFormat": "p99 lag"
        },
        {
          "refId": "B",
          "expr": "nodejs_eventloop_lag_mean_seconds{job=\"ledgr-app\"}",
          "legendFormat": "mean lag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Host memory used",
      "description": "Node-exporter view of the machine the server runs on, for context around the process-level numbers.",
      "datasource": { "type": "prometheus", "uid": "ledgr-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 36 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"}))",
          "legendFormat": "host memory used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single" }
      }
    }
  ]
}
