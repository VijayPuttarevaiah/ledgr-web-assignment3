# Local Supabase (started via `supabase start`) — see DECISIONS.md for why
# the newer sb_publishable_/sb_secret_ key pair is used instead of the
# legacy anon/service_role JWTs that `supabase start` also prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_LOCAL_SUPABASE_SERVICE_ROLE_KEY

# --- AI kill switch (§4) — OFF by default: no API keys available this session ---
AI_FEATURES_ENABLED=false
NEXT_PUBLIC_AI_FEATURES_ENABLED=false
AI_CATEGORIZATION_ENABLED=false
NEXT_PUBLIC_AI_CATEGORIZATION_ENABLED=false
AI_OCR_ENABLED=false
NEXT_PUBLIC_AI_OCR_ENABLED=false
AI_NARRATIVE_ENABLED=false
NEXT_PUBLIC_AI_NARRATIVE_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CATEGORIZATION=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_NARRATIVE=claude-sonnet-5
GOOGLE_CLOUD_VISION_API_KEY=
AI_MONTHLY_BUDGET_USD=5

# --- Rate limiting (§3, §9) — falls back to an in-memory limiter when unset ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron (§3, §6.5, §9) ---
CRON_SECRET=local-dev-cron-secret-change-me

# --- Error tracking (§3, §11) — optional locally ---
SENTRY_DSN=

LOG_LEVEL=info
